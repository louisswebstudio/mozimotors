# --- Sanity (content: cars, brands & models, testimonials, settings, texts, leads) ---------------
# Project id from sanity.io/manage. Leave empty to run the site on built-in demo data.
# Once set, Sanity is the ONLY data source (no demo fallback).
SANITY_PROJECT_ID=
SANITY_DATASET=production
# The dataset is private (it stores the leads), so the site reads with a token.
# sanity.io/manage › API › Tokens: « Viewer » token for reading, « Editor » token for saving leads.
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=
# Studio address, used for the « Ouvrir dans le Studio » link in lead emails.
SANITY_STUDIO_URL=https://mozimotors.sanity.studio

# Fallback cache lifetime for CMS data, in seconds (publishing in the Studio updates the site instantly
# through the webhook → /api/revalidate).
CMS_REVALIDATE=300
# Shared with the Sanity webhook (HTTP header X-Mozi-Secret). Use a long random string.
REVALIDATE_SECRET=change-me-long-random-string

# --- Lead emails (Resend) ------------------------------------------------------------------------
# resend.com › API Keys. The sender domain must be verified in Resend (e.g. mozimotors.ma).
RESEND_API_KEY=
LEAD_EMAIL_FROM=MoziMotors <site@mozimotors.ma>
# Recipient if Studio › Réglages › « Email qui reçoit les demandes » is empty.
LEAD_EMAIL_TO=

# Public URL of this site (used for sitemap, canonical & OG tags).
NEXT_PUBLIC_SITE_URL=https://www.mozimotors.ma
