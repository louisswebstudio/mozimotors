# Base URL of the WordPress install running the mozimotors-core plugin (no trailing slash).
# Leave empty to run the site on built-in demo data. Once set, WordPress is the ONLY data source
# (no demo fallback), so make sure the plugin is active and the REST API answers first.
# e.g. WP_API_URL=https://admin.mozimotors.ma
WP_API_URL=

# Same value as "Clé secrète partagée" in WP › Réglages › MoziMotors.
# Secures lead forwarding (Next → WP) and instant revalidation (WP → Next).
WP_SHARED_SECRET=change-me-long-random-string

# Fallback cache lifetime for WP data, in seconds.
WP_REVALIDATE=300

# Public URL of this site (used for sitemap, canonical & OG tags).
NEXT_PUBLIC_SITE_URL=https://www.mozimotors.ma
